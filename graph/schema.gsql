CREATE VERTEX Document(PRIMARY_ID doc_id STRING, title STRING, url STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX Event(PRIMARY_ID event_id STRING, name STRING);
CREATE VERTEX OlympicGames(PRIMARY_ID games_id STRING, name STRING);
CREATE VERTEX Athlete(PRIMARY_ID athlete_id STRING, name STRING);
CREATE VERTEX Sport(PRIMARY_ID sport_id STRING, name STRING);
CREATE VERTEX Venue(PRIMARY_ID venue_id STRING, name STRING);
CREATE VERTEX Country(PRIMARY_ID country_id STRING, name STRING);

CREATE DIRECTED EDGE DESCRIBES(FROM Document, TO Event);
CREATE DIRECTED EDGE PART_OF(FROM Event, TO OlympicGames);
CREATE DIRECTED EDGE WON_BY(FROM Event, TO Athlete);
CREATE DIRECTED EDGE IN_SPORT(FROM Event, TO Sport);
CREATE DIRECTED EDGE HELD_AT(FROM Event, TO Venue);
CREATE DIRECTED EDGE REPRESENTS(FROM Athlete, TO Country);
